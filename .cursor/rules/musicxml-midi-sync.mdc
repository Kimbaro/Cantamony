## 3. MusicXML, MIDI 마디 구간 연동 플랜

### 목표
- MIDI 재생 위치(tick)를 MusicXML 마디/노트와 매핑
- 재생 중 현재 마디를 악보에 하이라이트
- SeekBar로 마디 이동

### 아키텍처 설계

```
┌─────────────────────────────────────────────┐
│         시간 동기화 매핑 시스템               │
├─────────────────────────────────────────────┤
│                                             │
│  MIDI Tick (0 ~ totalTicks)                 │
│       ↓                                     │
│  [TickToMeasureMapper]                      │
│       ↓                                     │
│  MusicXML Measure Number                     │
│       ↓                                     │
│  OSMD Highlight                             │
│                                             │
└─────────────────────────────────────────────┘
```

### Phase 1: 시간 매핑 데이터 구조 설계

```kotlin
/**
 * MIDI tick과 MusicXML 마디를 매핑하는 데이터 클래스
 */
data class MeasureTimeMapping(
    val measureNumber: String,        // MusicXML 마디 번호
    val startTick: Long,              // 마디 시작 MIDI tick
    val endTick: Long,                // 마디 종료 MIDI tick
    val startTimeMs: Long,            // 마디 시작 시간 (ms)
    val endTimeMs: Long,              // 마디 종료 시간 (ms)
    val timeSignature: Pair<Int, Int> // 박자 (4/4, 3/4 등)
)

/**
 * 노트별 시간 매핑 (더 정밀한 동기화용)
 */
data class NoteTimeMapping(
    val measureNumber: String,
    val noteIndex: Int,                // 마디 내 노트 인덱스
    val noteId: String,               // OSMD에서 식별할 ID
    val startTick: Long,
    val endTick: Long,
    val midiNote: Int,                 // MIDI 노트 번호 (0-127)
    val xmlNote: String                // MusicXML 노트 (예: "C/4")
)
```

### Phase 2: 매핑 생성 유틸리티

```kotlin
/**
 * MusicXML과 MIDI를 시간 기준으로 매핑
 */
object MusicXmlMidiMapper {
    
    /**
     * MusicXML 마디와 MIDI tick을 매핑
     * 
     * 전략:
     * 1. MusicXML의 각 마디에 대해 박자 정보 추출
     * 2. MIDI의 템포 정보 추출 (Tempo 이벤트)
     * 3. 마디별 누적 tick 계산
     * 4. 매핑 테이블 생성
     */
    fun createMeasureMapping(
        measureDataList: List<MeasureData>,
        midiFile: MidiFile,
        initialBPM: Double = 120.0
    ): List<MeasureTimeMapping> {
        val mappings = mutableListOf<MeasureTimeMapping>()
        
        // 1. MIDI 템포 이벤트 추출
        val tempoEvents = extractTempoEvents(midiFile)
        
        // 2. MIDI 박자 정보 추출
        val timeSignatureEvents = extractTimeSignatureEvents(midiFile)
        
        // 3. MusicXML 마디 순회하며 tick 계산
        var currentTick: Long = 0
        var currentBPM = initialBPM
        var currentTimeSignature = Pair(4, 4) // 기본값
        
        measureDataList.forEach { measure ->
            // 마디의 박자 정보
            val measureTimeSig = measure.timeSignature
            if (measureTimeSig != Pair(4, 4)) {
                currentTimeSignature = measureTimeSig
            }
            
            // 마디 길이 계산 (박자 기준)
            val measureLengthInBeats = measureTimeSig.first.toDouble()
            val ticksPerBeat = midiFile.resolution
            val measureLengthInTicks = (measureLengthInBeats * ticksPerBeat).toLong()
            
            // 템포 변경 확인
            val tempoChange = tempoEvents.find { it.tick <= currentTick + measureLengthInTicks }
            if (tempoChange != null) {
                currentBPM = tempoChange.bpm
            }
            
            // 시간 계산 (ms)
            val ticksPerMs = (60000.0 / (currentBPM * ticksPerBeat))
            val startTimeMs = (currentTick * ticksPerMs).toLong()
            val endTimeMs = ((currentTick + measureLengthInTicks) * ticksPerMs).toLong()
            
            mappings.add(
                MeasureTimeMapping(
                    measureNumber = measure.measureNumber,
                    startTick = currentTick,
                    endTick = currentTick + measureLengthInTicks,
                    startTimeMs = startTimeMs,
                    endTimeMs = endTimeMs,
                    timeSignature = currentTimeSignature
                )
            )
            
            currentTick += measureLengthInTicks
        }
        
        return mappings
    }
    
    /**
     * MIDI 파일에서 템포 이벤트 추출
     */
    private fun extractTempoEvents(midiFile: MidiFile): List<TempoEvent> {
        val tempoEvents = mutableListOf<TempoEvent>()
        
        midiFile.tracks.forEach { track ->
            track.events.forEach { event ->
                if (event is Tempo) {
                    val bpm = 60000000.0 / event.tempo
                    tempoEvents.add(TempoEvent(event.tick, bpm))
                }
            }
        }
        
        return tempoEvents.sortedBy { it.tick }
    }
    
    /**
     * MIDI 파일에서 박자 정보 추출
     */
    private fun extractTimeSignatureEvents(midiFile: MidiFile): List<TimeSignatureEvent> {
        // TimeSignature 이벤트 추출 로직
        // ...
    }
}

/**
 * 템포 이벤트 데이터 클래스
 */
data class TempoEvent(
    val tick: Long,
    val bpm: Double
)

/**
 * 박자 이벤트 데이터 클래스
 */
data class TimeSignatureEvent(
    val tick: Long,
    val numerator: Int,
    val denominator: Int
)
```

### Phase 3: 실시간 동기화

```kotlin
class MainActivity : AppCompatActivity() {
    
    private var measureMappings: List<MeasureTimeMapping> = emptyList()
    private var currentMeasureIndex: Int = -1
    private var playbackUpdateHandler: Handler? = null
    
    /**
     * 재생 위치 추적 시작
     */
    private fun startPlaybackTracking() {
        playbackUpdateHandler = Handler(Looper.getMainLooper())
        
        val updateRunnable = object : Runnable {
            override fun run() {
                if (midiPlayer.isPlaying()) {
                    val currentTick = midiPlayer.getCurrentTick()
                    updateMeasureHighlight(currentTick)
                    updateSeekBar(currentTick)
                    playbackUpdateHandler?.postDelayed(this, 50) // 50ms마다 업데이트
                }
            }
        }
        
        playbackUpdateHandler?.post(updateRunnable)
    }
    
    /**
     * 현재 tick에 해당하는 마디 하이라이트
     */
    private fun updateMeasureHighlight(currentTick: Long) {
        val measureIndex = measureMappings.indexOfFirst { 
            currentTick >= it.startTick && currentTick < it.endTick 
        }
        
        if (measureIndex != currentMeasureIndex && measureIndex >= 0) {
            currentMeasureIndex = measureIndex
            val measure = measureMappings[measureIndex]
            
            // OSMD에 하이라이트 요청
            highlightMeasureInOSMD(measure.measureNumber)
            
            // 마디 정보 표시
            updateMeasureInfo(measure)
        }
    }
    
    /**
     * OSMD에서 마디 하이라이트
     */
    private fun highlightMeasureInOSMD(measureNumber: String) {
        val jsCode = """
            highlightMeasure('$measureNumber');
        """.trimIndent()
        
        webView.evaluateJavascript(jsCode, null)
    }
    
    /**
     * SeekBar 업데이트
     */
    private fun updateSeekBar(currentTick: Long) {
        val totalTicks = midiPlayer.getTotalTicks()
        if (totalTicks > 0) {
            val progress = ((currentTick * 100) / totalTicks).toInt()
            findViewById<SeekBar>(R.id.seekBarMeasure)?.progress = progress
            
            // 마디 정보 텍스트 업데이트
            val currentMeasure = measureMappings.find { 
                currentTick >= it.startTick && currentTick < it.endTick 
            }
            currentMeasure?.let {
                findViewById<TextView>(R.id.txtMeasure)?.text = 
                    "마디: ${it.measureNumber} / ${measureMappings.size}"
            }
        }
    }
}
```

### Phase 4: OSMD 하이라이트 JavaScript

```javascript
// OSMD HTML에 추가할 JavaScript 함수
function highlightMeasure(measureNumber) {
    // 이전 하이라이트 제거
    clearAllHighlights();
    
    // 해당 마디의 SVG 요소 찾기
    // OSMD는 마디별로 그룹화되어 있으므로 data-measure 속성으로 찾기
    const measureElements = document.querySelectorAll(`[data-measure="${measureNumber}"]`);
    
    measureElements.forEach(element => {
        // 배경색 변경 또는 테두리 추가
        element.style.backgroundColor = 'rgba(29, 185, 84, 0.2)'; // 반투명 녹색
        element.style.transition = 'background-color 0.3s';
    });
    
    // 해당 마디로 스크롤
    if (measureElements.length > 0) {
        measureElements[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
}

function clearAllHighlights() {
    document.querySelectorAll('[data-measure]').forEach(element => {
        element.style.backgroundColor = 'transparent';
    });
}

