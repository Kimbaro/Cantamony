<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 오프닝 비디오 배경 (TextureView: 센터크롭/줌으로 꽉 채우기 지원) -->
    <TextureView
        android:id="@+id/splashVideoTexture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- 배경 단색 (RGB 227, 227, 227) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_gray"
        android:clickable="false"
        android:focusable="false" />

    <!-- 아래로 스와이프해서 시작 (ComposeView with Backdrop effects) - splashRoot 전체를 채우도록 -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/scrollHintComposeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone" />

</FrameLayout>

