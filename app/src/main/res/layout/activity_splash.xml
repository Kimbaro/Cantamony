<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 배경 이미지 -->
    <ImageView
        android:id="@+id/splashBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="배경" />

    <!-- 블러 오버레이 (점진적 블러 효과) -->
    <View
        android:id="@+id/blurOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- 로고와 로딩바 컨테이너 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- 회사 로고 -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:scaleType="fitCenter"
            android:contentDescription="로고"
            android:layout_marginBottom="48dp" />

        <!-- 게이지 바 -->
        <com.robsonmartins.androidmidisynth.CircularGaugeView
            android:id="@+id/splashLoadingBar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp" />

        <!-- 로딩 메시지 -->
        <TextView
            android:id="@+id/splashLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="학습 앨범을 준비하고 있어요!"
            android:textSize="14sp"
            android:textColor="#b3b3b3"
            android:alpha="1.0" />
    </LinearLayout>

</FrameLayout>

